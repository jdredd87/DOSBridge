@ECHO OFF
REM ===================================================================
REM  dosbridge client install, for MS-DOS 6.22
REM
REM    INSTALL              mTCP, IF you have it, in C:\MTCP
REM    INSTALL C:\NET\MTCP  mTCP somewhere else
REM
REM  The directory is only where an OPTIONAL MTCP.NEW gets written for
REM  mTCP's diagnostic tools. The bridge itself needs no part of mTCP -- the
REM  last call to it, HTGET in the job poll, went on 2026-09-02.
REM
REM  Creates the four working directories, installs the agent loop and
REM  the tools, and drops a suggested AUTOEXEC at C:\AUTOEXEC.NEW.
REM
REM  It does NOT touch your AUTOEXEC.BAT or CONFIG.SYS. Overwriting a
REM  boot file from a script on a machine you may not be sitting at is
REM  how you end up needing a boot floppy.
REM ===================================================================

SET MTCPDIR=%1
IF "%MTCPDIR%"=="" SET MTCPDIR=C:\MTCP

ECHO.
ECHO dosbridge client install
ECHO ========================
ECHO   mTCP directory: %MTCPDIR%   (optional, diagnostics only)
ECHO.

REM --- directories ---------------------------------------------------
REM \NUL is the DOS idiom for "does this directory exist".
IF NOT EXIST C:\AI\NUL MD C:\AI
IF NOT EXIST C:\AGENT\NUL MD C:\AGENT
IF NOT EXIST C:\TOOLS\NUL MD C:\TOOLS
IF NOT EXIST C:\WORK\NUL MD C:\WORK
IF NOT EXIST %MTCPDIR%\NUL MD %MTCPDIR%
ECHO [1/4] Directories: C:\AI C:\AGENT C:\TOOLS C:\WORK

REM --- agent loop ----------------------------------------------------
REM Destinations are spelled out in full on purpose. "COPY X C:\AI\"
REM with a trailing backslash fails silently on DOS 6.22.
COPY AI.BAT C:\AI\AI.BAT > NUL
COPY REBOOT.COM C:\AI\REBOOT.COM > NUL
COPY COLDBOOT.COM C:\AI\COLDBOOT.COM > NUL
REM  The build stamp AI.BAT shows at boot, so the machine itself can say
REM  which version it is running without asking the Windows side.
IF EXIST VERSION.TXT COPY VERSION.TXT C:\AI\VERSION.TXT > NUL
REM  The bridge's own network settings. Without this the tools fall back to
REM  %MTCPCFG%, and a machine with no mTCP installed would have no addresses
REM  at all -- so this file is what makes mTCP genuinely optional.
IF EXIST NET.CFG COPY NET.CFG C:\AI\NET.CFG > NUL
ECHO [2/4] Agent loop  -^> C:\AI

REM --- tools ---------------------------------------------------------
IF NOT EXIST *.EXE GOTO NOTOOLS
COPY *.EXE C:\TOOLS > NUL
REM  The demos (RAYCAST, PARALLAX, ...) travel in DEMOS\ to keep this folder
REM  to the tools, but install beside them, as they always have: the Windows
REM  side's upgrade and verify look for them in C:\TOOLS.
IF EXIST DEMOS\*.EXE COPY DEMOS\*.EXE C:\TOOLS > NUL
REM  The .COM tools need naming one by one: the wildcard above only takes
REM  .EXE, and a bare "COPY *.COM" would drag REBOOT.COM and COLDBOOT.COM in
REM  with them -- those belong to the agent in C:\AI and were placed above.
REM
REM  The lines below are GENERATED by makekit.py from what is actually in the
REM  kit. A marker below is substituted at build time -- and is not
REM  named in this comment, because naming it got it substituted too
REM  and turned this very line into a half-formed COPY command.
REM  There used to be one hand-written line here for
REM  KEYHIT.COM, and when ELAPSED.COM arrived it was silently not installed --
REM  the tool was in the kit, the agent looked for it, and it was never
REM  copied. Anything that has to be kept in step with a directory listing
REM  should be read from the listing.
IF EXIST ELAPSED.COM COPY ELAPSED.COM C:\TOOLS\ELAPSED.COM > NUL
IF EXIST KEYHIT.COM COPY KEYHIT.COM C:\TOOLS\KEYHIT.COM > NUL
IF EXIST KINJ.COM COPY KINJ.COM C:\TOOLS\KINJ.COM > NUL
IF EXIST KNET.COM COPY KNET.COM C:\TOOLS\KNET.COM > NUL
IF EXIST SCRLOFF.COM COPY SCRLOFF.COM C:\TOOLS\SCRLOFF.COM > NUL
ECHO [3/4] Tools       -^> C:\TOOLS
GOTO CFG
:NOTOOLS
ECHO [3/4] Tools       -^> none in this kit, skipped

REM --- mTCP config ---------------------------------------------------
:CFG
REM  Your MTCP.CFG is NEVER written, overwritten or edited by this script.
REM  It holds settings only you know -- the packet interrupt your card is on,
REM  and on a DHCP setup a lease that other tools rely on. An example is
REM  dropped alongside it instead, and merging is left to you.
COPY MTCP.NEW %MTCPDIR%\MTCP.NEW > NUL
IF EXIST %MTCPDIR%\MTCP.CFG GOTO HAVECFG
ECHO [4/4] mTCP config -^> wrote %MTCPDIR%\MTCP.NEW
ECHO       You have no MTCP.CFG yet. To use the example as-is:
ECHO           REN %MTCPDIR%\MTCP.NEW MTCP.CFG
GOTO CFGDONE
:HAVECFG
ECHO [4/4] mTCP config -^> wrote %MTCPDIR%\MTCP.NEW
ECHO       Your existing MTCP.CFG was left untouched. Compare the two and
ECHO       copy across only what you need (IPADDR, NETMASK, GATEWAY).
:CFGDONE

REM --- suggested AUTOEXEC --------------------------------------------
:AUTOEX
COPY AUTOEXEC.NEW C:\AUTOEXEC.NEW > NUL

ECHO.
ECHO Done. Nothing has been made to run yet.
ECHO.
ECHO NEXT, BY HAND:
ECHO   1. Check your packet driver loads (PM2000.COM or NE2000.COM).
ECHO      That is the ONLY network software this needs. No mTCP.
ECHO   2. Check C:\AI\NET.CFG names this machine's IPADDR,
ECHO      NETMASK and GATEWAY. The agent reads it; nothing else does.
ECHO   3. Compare C:\AUTOEXEC.NEW against your AUTOEXEC.BAT and merge
ECHO      the parts you want. Keep a backup:
ECHO         COPY C:\AUTOEXEC.BAT C:\AUTOEXEC.SAV
ECHO   4. Reboot. The Windows side should log a poll within seconds.
ECHO.
ECHO OPTIONAL: %MTCPDIR%\MTCP.NEW was written for mTCP's own
ECHO   tools (PING, SNTP, PKTTOOL). The bridge does not use them, so
ECHO   ignore it unless you want them for diagnosis.
ECHO.
ECHO Do NOT run DHCP. See the README - an expiring lease strands the
ECHO machine and the agent loop cannot recover from it on its own.
ECHO.
